# Credenciais do Postgres (madm) usadas pelas Netlify Functions (netlify/functions/*)
# pra ler os dados reais via madm.view_relatorio_judit / madm.view_app_kommo_leads /
# madm.view_app_emitidos_e_assinados. O usuário aqui deve ter SOMENTE permissão de
# SELECT nessas views — nunca INSERT/UPDATE/DELETE.
# Nunca commitar os valores reais — só este exemplo.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Segredo usado para assinar os tokens de login (netlify/functions/auth-login.ts).
# Gere uma string aleatória longa (ex: openssl rand -hex 32) e nunca reutilize em outro projeto.
AUTH_SECRET=

# Usuários fixos do dashboard, em JSON. Nunca commitar o valor real.
# "role":"master" pode ver /logs (quem entrou e quais páginas visitou); sem role = usuário comum.
# Exemplo: [{"usuario":"diretoria@empresa.com","senha":"troque-essa-senha","role":"master"}]
DASHBOARD_USERS=

# Logins (parte antes do @madmbrasil.com.br) que já entram como "master" ao se
# autocadastrarem em /login, separados por vírgula.
# Exemplo: gustavo.santos,bruno.resende,antonio.filho
MASTER_LOGINS=
